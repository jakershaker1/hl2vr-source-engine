<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Standalone VR headset, not a handheld touchscreen device. -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="false" />
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.vr.mode" android:required="false" />

    <!-- Android XR: declares this as an OpenXR immersive app. Without this,
         the system treats the app as an ordinary 2D Android app that merely
         happens to call OpenXR, and confines it to a windowed Home Space
         panel no matter what the start-mode property below says (confirmed:
         Khronos's own hello_xr sample declares this and reaches Full Space;
         we didn't declare it and never did). Version 0x00010001 = OpenXR 1.1,
         matching hello_xr. -->
    <uses-feature android:name="android.software.xr.api.openxr" android:version="0x00010001" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Needed to discover/bind the OpenXR runtime broker on OpenXR-conformant devices. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <!-- Android XR. NOTE: this is protectionLevel signature|privileged, so a
         sideloaded/debug build can never actually be granted it - the runtime
         logs "Permission failure: android.permission.XR_TRACKING_IN_BACKGROUND"
         on every launch (along with HAND_TRACKING, HEAD_TRACKING,
         EYE_TRACKING_*, SCENE_UNDERSTANDING_*, ...). That logging is normal
         noise, not a fault: Full Space and head tracking both work fine
         without it. Declared for the benefit of properly-signed builds. -->
    <uses-permission android:name="android.permission.XR_TRACKING_IN_BACKGROUND" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:hasCode="false">

        <!-- Android XR shows apps in a windowed "Home Space" panel by default;
             OpenXR apps need to explicitly request "Full Space" (fully
             immersive) via this start-mode property. UNMANAGED (not MANAGED)
             is required for OpenXR apps specifically - the app owns the full
             space directly via OpenXR's own session lifecycle. Declared at
             <application> level (not on the <activity>) to match hello_xr,
             the known-working reference. -->
        <property
            android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
            android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_UNMANAGED" />

        <!-- Meta Quest -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest|quest2|quest3|quest3s|questpro" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />

        <!-- Pico -->
        <meta-data android:name="pvr.app.type" android:value="vr" />

        <!-- Android XR (Samsung Galaxy XR / Google): grants the app's linker
             namespace permission to dlopen the platform's system OpenXR
             runtime. Without this, xrCreateInstance fails with
             XR_ERROR_RUNTIME_UNAVAILABLE - the loader finds
             /system/etc/openxr/1/active_runtime.json but the linker refuses
             to load the runtime library it points to. -->
        <uses-native-library android:name="libopenxr.google.so" android:required="false" />

        <activity android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:resizeableActivity="false"
            android:exported="true">

            <!-- liblauncher.so exports ANativeActivity_onCreate (see launcher/android/android_main.cpp) -->
            <meta-data android:name="android.app.lib_name" android:value="launcher" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
                <category android:name="com.pico.action.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
