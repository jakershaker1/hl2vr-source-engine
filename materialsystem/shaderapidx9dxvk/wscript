#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'shaderapidx9dxvk'

def options(opt):
	# stub
	return

def configure(conf):
	conf.env.append_unique('DEFINES',[
		'SHADERAPIDX9',
		'SHADER_DLL_EXPORT',
		#'PROTECTED_THINGS_ENABLE', # conflicts with stlport
		'strncpy=use_Q_strncpy_instead',
		'_snprintf=use_Q_snprintf_instead',
		# Takes the "real D3D9 headers" branch in public/togl/rendermechanism.h
		# instead of the DX_TO_GL_ABSTRACTION (togl-over-GL) branch.
		'USE_ACTUAL_DX',
		# Tells rendermechanism.h to pull in DXVK Native's own portable
		# d3d9.h/windows.h (vendored at ../../dxvk_native/include/native/)
		# instead of the real Microsoft/Windows SDK headers that branch
		# otherwise assumes (gated behind #ifdef WIN32, which is false here).
		'DXVK_NATIVE',
	])

	if conf.env.DEST_OS == 'android':
		conf.check(lib='openxr_loader', uselib_store='OPENXR')


def build(bld):
	source = [
		'colorformatdx8.cpp',
		'd3dx9math_shim.cpp',
		'dxvk_format_fix.cpp',
		'dxvk_xr_bridge.cpp',
		'../../public/filesystem_helpers.cpp',
		'hardwareconfig.cpp',
		'meshbase.cpp',
		'meshdx8.cpp',
		'shaderapidx8.cpp',
		'shaderdevicebase.cpp',
		'shaderapibase.cpp',
		'shaderdevicedx8.cpp',
		'shadershadowdx8.cpp',
		'texturedx8.cpp',
		'TransitionTable.cpp',
		'cvballoctracker.cpp',
		'vertexdecl.cpp',
		'vertexshaderdx8.cpp',
		'winutils.cpp',
		'../../public/tier0/memoverride.cpp'
	]

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
		'../',
		'../../dxvk_native/include/native/directx',
		'../../dxvk_native/include/native/windows',
	] + bld.env.INCLUDES_SDL2

	defines = []

	libs = ['tier0','tier1','tier2','vstdlib','togl','bitmap','mathlib','SDL2']
	linkflags = ['-ldxvk_d3d9', '-ldxvk_dxgi', '-lbz2']

	if bld.env.DEST_OS == 'android':
		libs += ['ANDROID_SUPPORT', 'OPENXR']
		includes += ['../../openxr_sdk/include', '../../launcher/android']
		source += ['../../launcher/android/vr_xr_vulkan.cpp']
		linkflags += ['-lvulkan']

	# Vendored DXVK Native .so's, built via meson for arm64 Android and
	# dropped in prebuilt/android/aarch64/ (already on every Android module's
	# linker search path - see the root wscript's -L flag). No conf.check()
	# needed, unlike the OPENXR uselib - we already know these exist since we
	# built them ourselves this session.

	install_path = bld.env.LIBDIR

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		linkflags = linkflags,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)
